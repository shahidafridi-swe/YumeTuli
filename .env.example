# YumeTuli — copy to .env and fill in. Never commit .env.
APP_NAME=YumeTuli
APP_KEY=
APP_URL=http://localhost:8000
WEB_URL=http://localhost:3000
APP_LOCALE=en
APP_TIMEZONE=Asia/Dhaka

# Host ports (change if busy)
API_PORT=8000
WEB_PORT=3000
MYSQL_HOST_PORT=3307
# Your user/group id so files created by containers stay yours (run `id -u`, `id -g`)
UID=1000
GID=1000

# MySQL
DB_DATABASE=yumetuli
DB_USERNAME=yumetuli
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Owner account (created by `php artisan db:seed`)
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=

# Reverb (websocket)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Media storage: local now, s3 (MinIO) later
MEDIA_DISK=local

# Optional (later phases)
ELEVENLABS_API_KEY=
