 "segments": [
  {
   "start": 0.0,
   "end": 6.92,
   "text": "এবার গলাসে ঠিক বাইর বাতাশ তুকু দেখি এই বাতাশে পানি আছে জোলিয়ো বাশ পোহোয়ে চোখে দেখা জয়ে না"
  },
  {
   "start": 7.15,
   "end": 14.53,
   "text": "ঠান্ডা গলাসের গায়ে লেগে বাতাস্টা ঠান্ডা হয়ে জথেশ্টো ঠান্ডা হলে সেই বাস্পের কিছুটা তারোল পানি হয়ে কাছের গায়"
  },
  {
   "start": 14.53,
   "end": 16.53,
   "text": "একেই বলে ঘোনি ভাবন।"
  }
 ]
