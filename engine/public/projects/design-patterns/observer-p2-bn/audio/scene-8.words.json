 "segments": [
  {
   "start": 0.0,
   "end": 3.5,
   "text": "আগের পওরবে, ঵েদের সেশন নিজে ই ডিস্পলোর তালিকা রাখতো।"
  },
  {
   "start": 3.5,
   "end": 6.72,
   "text": "এখানে শেই শোংজোক শামলায় লারা঵েলের ই঵েন দিস্পাচের"
  },
  {
   "start": 6.95,
   "end": 8.97,
   "text": "অব্জোর্র্র পাট্রের ধারোনাটা একি."
  },
  {
   "start": 9.09,
   "end": 10.59,
   "text": "এক জাএগাই কিছু ঘোটলে,"
  },
  {
   "start": 10.67,
   "end": 12.27,
   "text": "জারা সেই খাবোরে আগ্রোহি,"
  },
  {
   "start": 12.27,
   "end": 14.27,
   "text": "তারা প্রতে কে নিজের কাচটা করে"
  }
 ]
