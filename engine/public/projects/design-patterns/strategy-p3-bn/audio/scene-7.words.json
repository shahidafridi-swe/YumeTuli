  {
   "start": 0.0,
   "end": 3.16,
   "text": "এবারে কলিক টাই ফিরে জয়ে কাস্টমার একস্প্প্রেস বাচ্লো"
  },
  {
   "start": 3.16,
   "end": 8.58,
   "text": "লার঵েল কন্ট্রলের প্রথমে জাচাই করেনে একস্প্রেস আমাদের অনুমধিতো ডিলি঵্রি অপশন কিনা"
  },
  {
   "start": 8.7,
   "end": 12.3,
   "text": "তারপার একস্প্রস ডিলি঵্রি অব্য্ট পানিয় চেকাউত সের঵িস কে দায়"
  },
  {
   "start": 12.3,
   "end": 13.86,
   "text": "সকরিনে এলইন টাদাখো"
  }
 ]
