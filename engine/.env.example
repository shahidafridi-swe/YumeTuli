# Voiceover provider: edge (free, needs `pip install edge-tts`) | openai | elevenlabs | none
TTS_PROVIDER=edge
# Voice is picked from scenes.json "language" (bn|en). Override per project with "voice" in scenes.json.
# edge-tts Bangla: bn-BD-NabanitaNeural (F) / bn-BD-PradeepNeural (M). English: en-US-AndrewNeural (M) / en-US-AvaNeural (F)
EDGE_VOICE_BN=bn-IN-TanishaaNeural
EDGE_VOICE_EN=en-US-AndrewNeural
EDGE_RATE_BN=-5%
EDGE_RATE_EN=+12%

OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE_BN=alloy
OPENAI_TTS_VOICE_EN=alloy
OPENAI_IMAGE_MODEL=gpt-image-1

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_BN=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_MODEL=eleven_multilingual_v2
